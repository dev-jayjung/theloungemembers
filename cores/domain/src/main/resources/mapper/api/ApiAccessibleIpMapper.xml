<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.theloungemembers.core.api.mapper.ApiAccessibleIpMapper">

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM api_accessible_ip
        <include refid="where"/>
    </select>

    <select id="selectList" resultType="com.theloungemembers.core.api.ApiAccessibleIpResult">
        SELECT
            uid
            , ip_address
            , on_service
            , memo
            , reg_date
            , update_date
        FROM api_accessible_ip
        <include refid="where"/>
        <include refid="CommonMapper.sortSql"/>
        <include refid="CommonMapper.pageSql"/>
    </select>

    <select id="selectUidByIpAddress" resultType="java.lang.Long">
        SELECT uid
        FROM api_accessible_ip
        WHERE ip_address = #{ipAddress}
    </select>

    <sql id="where">
        <where>
            <choose>
                <when test="searchTarget == 'uid'">
                    AND uid = #{searchValue}::INTEGER
                </when>
                <when test="searchTarget == 'ip_address'">
                    AND ip_address = #{searchValue}
                </when>
            </choose>
            <if test="onService != null">
                AND on_service = #{onService}
            </if>
        </where>
    </sql>

</mapper>
