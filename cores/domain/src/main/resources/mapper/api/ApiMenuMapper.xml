<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.theloungemembers.core.api.mapper.ApiMenuMapper">
    <select id="selectList" resultType="com.theloungemembers.core.api.ApiMenuResult">
        SELECT
               uid
             , group_code
             , code
             , name
             , display_ordinal
             , on_service
             , link_url
             , memo
             , reg_date
             , update_date
          FROM API_MENU
          <include refid="where"/>
          <include refid="CommonMapper.sortSql"/>
          <include refid="CommonMapper.pageSql"/>
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT
               COUNT(1)
          FROM API_MENU
          <include refid="where"/>
    </select>

    <sql id="where">
        <where>
            <if test="onService != null">
                AND on_service = #{onService}
            </if>
        </where>
    </sql>

    <select id="existsApiMenu" resultType="java.lang.Boolean">
        SELECT 1
          FROM API_MENU
         WHERE code = #{code}
           AND on_service = '${@com.theloungemembers.core.type.ServiceStatus@IN_SERVICE.code}'
    </select>

</mapper>