<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.theloungemembers.core.api.mapper.ApiSendCompanyDataMapper">

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM api_send_company_data
        <include refid="where"/>
    </select>

    <select id="selectList" resultType="com.theloungemembers.core.api.ApiSendCompanyDataResult">
        SELECT
               uid
             , api_account_id
             , company_name
             , type
             , lounge_coupon_issue_history_uid
             , coupon_num
             , admission_count
             , use_type
             , send_type
             , send_count
             , send_date
             , send_url
             , json_data
             , response_data
             , response_code
             , response_msg
             , reg_date
             , update_date
        FROM api_send_company_data
        <include refid="where"/>
        <include refid="CommonMapper.sortSql"/>
        <include refid="CommonMapper.pageSql"/>
    </select>

    <sql id="where">
        <where>
            <choose>
                <when test="searchTarget == 'uid'">
                    AND uid = #{searchValue}::INTEGER
                </when>
                <when test="searchTarget == 'api_account_id'">
                    AND api_account_id = #{searchValue}
                </when>
                <when test="searchTarget == 'api_account_id_like'">
                    AND api_account_id LIKE '%' || #{searchValue} || '%'
                </when>
                <when test="searchTarget == 'company_name_like'">
                    AND company_name LIKE '%' || #{searchValue} || '%'
                </when>
                <when test="searchTarget == 'coupon_num_like'">
                    AND coupon_num LIKE '%' || #{searchValue} || '%'
                </when>
            </choose>
            <choose>
                <when test="startDtm != null and endDtm != null">
                    AND reg_date BETWEEN #{startDtm} AND #{endDtm}
                </when>
                <when test="startDtm != null">
                    AND reg_date >= #{startDtm}
                </when>
                <when test="endDtm != null">
                    <![CDATA[
                        AND reg_date  <= #{endDtm}
                    ]]>
                </when>
            </choose>
        </where>
    </sql>


</mapper>
