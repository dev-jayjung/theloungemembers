<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.theloungemembers.core.lounge.mapper.LoungeMapper">
    <resultMap id="LoungeResultMap" type="com.theloungemembers.core.lounge.LoungeResult">
        <id property="uid" column="uid"/>
        <result property="code" column="code"/>
        <result property="serviceType" column="service_type"/>
        <result property="subType" column="sub_type"/>
        <result property="companyAffiliatedCode" column="company_affiliated_code"/>
        <result property="cityUid" column="city_uid"/>
        <result property="airportUid" column="airport_uid"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="selectList" resultMap="LoungeResultMap">
        SELECT
               uid
             , code
             , service_type
             , sub_type
             , company_affiliated_code
             , city_uid
             , airport_uid
             , name
          FROM LOUNGE
         <include refid="CommonMapper.sortSql"/>
         <include refid="CommonMapper.pageSql"/>
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT
               COUNT(1)
          FROM LOUNGE
    </select>
</mapper>